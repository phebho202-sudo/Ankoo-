{
  "expo": {
    "name": "Mojere Market",
    "slug": "mojere-market",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mojeremarket",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ng.mojeremarket.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ng.mojeremarket.app",
      "adaptiveIcon": {
        "backgroundColor": "#0F7A4A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F7A4A",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-image",
      "expo-font",
      "expo-asset",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mojere Market needs access to your photos so you can add pictures of items you want to sell.",
          "cameraPermission": "Mojere Market needs your camera so you can take pictures of items you want to sell."
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0F7A4A"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "mojeremarket",
    "extra": {
      "eas": {
        "projectId": "2ddd564c-ed98-4348-bb7a-981914ae759a"
      }
    }
  }
}
