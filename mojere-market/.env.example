# Mojere Market — app settings
#
# HOW TO USE: make a copy of this file named exactly `.env` (in this same
# mojere-market folder) and fill in the two values. The `.env` file is
# ignored by Git, so your values are never uploaded to GitHub.
#
# Where to find them: supabase.com → your existing project →
# Project Settings → API (or "API Keys").

# Your project URL. Looks like: https://abcdefghijklmnop.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# The PUBLIC key: labelled "anon public" or "publishable" (starts with eyJ... or sb_publishable_).
# NEVER put the "service_role" or "secret" key here. The app will refuse to start with it,
# because anything in this file is built into the app where anyone could read it.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Payments (Paystack). Leave as false until Paystack is set up, tested in
# test mode, and you have approved going live. Secret keys NEVER go here:
# they belong in Supabase → Edge Functions → Secrets.
EXPO_PUBLIC_PAYMENTS_ENABLED=false
