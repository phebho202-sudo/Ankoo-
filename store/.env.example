# Copy to your host's environment variables. Never commit real values.
NODE_ENV=production
BASE_URL=https://www.your-ankoo-domain.com
ADMIN_EMAILS=you@example.com
DB_PATH=/data/store.db
UPLOAD_DIR=/data/uploads
TRUST_PROXY=1

# Payments (Paystack dashboard > Settings > API Keys & Webhooks)
PAYSTACK_SECRET_KEY=

# Email (resend.com): MAIL_FROM must use a domain verified in Resend
RESEND_API_KEY=
MAIL_FROM=ANKOO <orders@your-ankoo-domain.com>
ORDER_NOTIFY_EMAIL=

# WhatsApp Cloud API automated replies (optional)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Instagram live feed (optional)
INSTAGRAM_ACCESS_TOKEN=

# Analytics can also be set in Admin > Settings
GA_MEASUREMENT_ID=
META_PIXEL_ID=
GOOGLE_SITE_VERIFICATION=
