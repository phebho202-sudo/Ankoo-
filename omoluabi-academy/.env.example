# Used by docker-compose. Copy to .env (git-ignored) and fill in.
# Optional automation token for scripts; leave blank if unused.
ADMIN_API_TOKEN=
POSTGRES_USER=omoluabi
POSTGRES_PASSWORD=omoluabi
POSTGRES_DB=omoluabi
PROVIDER_MODE=sample
# Provider keys stay blank until the owner authorises each account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=
