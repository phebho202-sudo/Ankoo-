# Used by docker-compose. Copy to .env (git-ignored) and fill in.
# Optional automation token for scripts; leave blank if unused.
ADMIN_API_TOKEN=
POSTGRES_USER=omoluabi
POSTGRES_PASSWORD=omoluabi
POSTGRES_DB=omoluabi
PROVIDER_MODE=sample
# Provider keys stay blank until the owner authorises each account.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=

# --- Publishing (Phase 8): see docs/API_SETUP.md section 6 ---
# Fernet key for encrypting stored platform tokens (required before connecting accounts).
TOKEN_ENCRYPTION_KEY=
# The dashboard's public address; OAuth redirect URIs are built from it.
PUBLIC_BASE_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Public address of stored media (needed only for Instagram).
PUBLIC_MEDIA_BASE_URL=

# --- Payments (Phase 9): Paystack secret key. Use a test key (sk_test_...) first. ---
PAYSTACK_SECRET_KEY=
