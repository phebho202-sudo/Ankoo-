# Production settings. Copy to .env.prod on the server (never commit it), fill in, then:
#   chmod 600 .env.prod
# Random values:  openssl rand -hex 24

DOMAIN=admin.example.ng
PUBLIC_BASE_URL=https://admin.example.ng
CORS_ORIGINS=https://admin.example.ng

POSTGRES_USER=omoluabi
POSTGRES_PASSWORD=
POSTGRES_DB=omoluabi
REDIS_PASSWORD=

# Keep "sample" until each provider account has been authorised by the owner.
PROVIDER_MODE=sample
SESSION_TTL_HOURS=12
# Optional automation token (at least 32 characters), or blank.
ADMIN_API_TOKEN=

# Fernet key for stored platform tokens. Keep a safe copy: if lost, every account must be
# reconnected.  python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Media storage: Cloudflare R2 (private bucket) recommended in production.
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Owner alerts: a Slack/Discord/Google Chat incoming webhook, or any JSON endpoint.
ALERT_WEBHOOK_URL=

# Providers (docs/API_SETUP.md). Leave blank until the owner authorises each one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_USD_PER_1K_CHARS=0.30
YOUTUBE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PUBLIC_MEDIA_BASE_URL=
PAYSTACK_SECRET_KEY=

BACKUP_KEEP_DAYS=14
