# Copy to backend/.env for local runs. NEVER commit a real .env file.
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json

# "sample": every AI/publishing provider uses offline sample adapters (no network, no cost).
# "live":   real providers are used, but ONLY those whose credentials are configured.
PROVIDER_MODE=sample

DATABASE_URL=postgresql+psycopg://omoluabi:omoluabi@localhost:5432/omoluabi
REDIS_URL=redis://localhost:6379/0

# Comma-separated origins allowed to call the API (the admin dashboard).
CORS_ORIGINS=http://localhost:3000

# Optional automation token for scripts/curl (the dashboard uses owner login). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
# Owner login sessions last this many hours.
SESSION_TTL_HOURS=12

# Local file storage (used until Cloudflare R2 is configured).
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./var/storage

# --- Provider credentials: leave blank until the owner authorises each account ---
ANTHROPIC_API_KEY=
# Claude model and effort for research. Opus 5.5 is the default; a cheaper model is your choice
# (e.g. claude-sonnet-5-5 or claude-haiku-5-5). See docs/API_SETUP.md and docs/COSTS.md.
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ELEVENLABS_API_KEY=
YOUTUBE_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Worker safety
TASK_MAX_RETRIES=3
